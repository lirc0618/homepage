doctype html
html(lang="zh-CN")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width,initial-scale=1")
    title #{channel.title} · #{main.name}
    meta(name="description" content=channel.description)
    link(rel="icon" href="../assets/favicon.svg")
    link(rel="stylesheet" href=`../css/channels.css?v=${assetVersion}`)
  body
    header.page-header
      a.brand(href="../") #{main.name}
      nav(aria-label="频道导航")
        each item, slug in channels
          a(href=`../${slug}/` aria-current=(slug === current ? 'page' : undefined)) #{item.title}
    main.channel-page
      p.eyebrow #{main.name} / #{channel.title}
      h1 #{channel.title}
      p.description #{channel.description}
      if channel.items.length
        .entries
          each item in channel.items
            article.entry
              if item.date
                time(datetime=item.date) #{item.date}
              h2
                a(href=item.url) #{item.title}
              if item.summary
                p.body #{item.summary}
              a.entry-link(href=item.url) 阅读全文 →
              if item.href && /^(https?:|mailto:)/.test(item.href)
                a.entry-link(href=item.href target="_blank" rel="noopener noreferrer") #{item.metadata.linkText || '查看相关链接'} ↗
      else
        .empty
          span.empty-mark —
          h2 待更新
          p 更多内容即将在这里记录。
      a.back(href="../") ← 返回主页
