include channel-icon.pug
.content.content-main
	#card
		.card-inner.fade
			header
				.avatar-frame(style=`width:${main.avatar.width}px;height:${main.avatar.height}px;display:inline-block;position:relative;overflow:hidden;border-radius:50%`)
					img(src=main.avatar.link width=main.avatar.width height=main.avatar.height alt="个人头像" style=`width:100%;height:100%;display:block;transform:scale(${main.avatar.zoom || 1});transform-origin:${main.avatar.positionX || "50%"} ${main.avatar.positionY || "50%"}`)
				h1 #{main.name}
				h2#signature(original-content=main.signature) #{main.signature}
			ul
				each item in main.ul
					li
						if item.href
							a(href=item.href aria-label=item.text target=(item.href.startsWith("https://") ? "_blank" : undefined) rel="noopener noreferrer")
								+channelIcon(item.icon)
								span #{item.text}
						else
							span.pending(title="链接待填写")
								+channelIcon(item.icon)
								span #{item.text} · 待填写
			.social-links
				each item in main.social
					a(href=item.href target="_blank" rel="noopener noreferrer") #{item.text}
			footer.credit
				a(href="https://github.com/SimonAKing/HomePage" target="_blank" rel="noopener noreferrer") Based on SimonAKing / HomePage
	canvas.grid-background#gridCanvas
